{
  "name": "x-tweet-scraper",
  "version": "1.0.0",
  "description": "Browserless X (Twitter) scraper for Apify: HTTP-only internal GraphQL, guest-token auth, strict output contract, server-authoritative free-tier gate.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "apify": "^3.2.6",
    "got-scraping": "^4.0.6",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
