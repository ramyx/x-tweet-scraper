# Actor environment variables. On Apify these are set in
# Actor → Settings → Environment variables, marked as secret. Never committed.
#
# These only say WHERE to ask. Faking them cannot raise the cap: a response that
# does not verify against ENTITLEMENTS_PUBLIC_KEY is discarded, and discarding
# means the run is treated as free.
ENTITLEMENTS_URL=https://your-worker.workers.dev/v1/check
ENTITLEMENTS_SHARED_SECRET=
ENTITLEMENTS_PUBLIC_KEY=
